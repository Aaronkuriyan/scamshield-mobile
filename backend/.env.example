# ==========================================
# SCAMSHIELD Backend Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# AI Provider Configuration (Groq recommended for high-speed real-time inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback / Alternate AI Provider (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Threshold Configuration (0-100 score)
SUSPICIOUS_THRESHOLD=35
SCAM_THRESHOLD=70

# Security & CORS
ALLOWED_ORIGINS=*
API_RATE_LIMIT=60
