.env.local
*.env
*.pem
*.key
*.jks
*.keystore

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Android & Gradle
.gradle/
build/
app/build/
android/build/
android/app/build/
*/build/
local.properties
*.apk
*.ap_
*.aab
*.dex
*.class
.cxx/
captures/
output.json

# Android Studio & IDEs
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
*.iml
.vscode/
*.swp
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Testing & Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
